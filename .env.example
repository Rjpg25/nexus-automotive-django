# Local: copia a .env y genera tu propia clave. Nunca subas .env a Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=America/Guayaquil
# Producción: define DATABASE_URL con la conexión PostgreSQL del servidor.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/nexus
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio
# Solo para crear la cuenta inicial en despliegues sin consola:
# NEXUS_ADMIN_USERNAME=
# NEXUS_ADMIN_PASSWORD=
# NEXUS_ADMIN_EMAIL=
